<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск СНИЛС" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Поиск номеров СНИЛС (формат: XXX-XXX-XXX XX)" 
                   FontSize="18" FontWeight="Bold" 
                   Margin="0,0,0,10"/>

        <GroupBox Grid.Row="1" Header="Текст для поиска" Margin="0,0,0,10">
            <TextBox x:Name="InputTextBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="14"
                     Margin="5"/>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Поиск через Regex" 
                    Width="180" Height="35" 
                    Margin="0,0,10,0"
                    Click="BtnRegex_Click"/>
            <Button Content="Поиск через автомат" 
                    Width="180" Height="35"
                    Margin="0,0,10,0"
                    Click="BtnAutomaton_Click"/>
            <Button Content="Очистить" 
                    Width="120" Height="35"
                    Click="BtnClear_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="3" Header="Результаты поиска">
            <DataGrid x:Name="ResultsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      Margin="5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="40"/>
                    <DataGridTextColumn Header="Совпадение" Binding="{Binding Value}" Width="*"/>
                    <DataGridTextColumn Header="Позиция" Binding="{Binding Position}" Width="80"/>
                    <DataGridTextColumn Header="Длина" Binding="{Binding Length}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <TextBlock x:Name="StatusText" 
                   Grid.Row="4" 
                   Text="Готово к работе"
                   Margin="0,10,0,0"
                   Foreground="DarkGreen"/>
    </Grid>
</Window>